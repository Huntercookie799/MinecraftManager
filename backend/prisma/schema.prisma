generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model World {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  path      String
  isBackup  Boolean  @default(false)
  createdAt DateTime @default(now())
}
