{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "app/**/*.ts",
    "bootstrap/**/*.ts",
    "config/**/*.ts",
    "routes/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
