model User {
  id         Int                @id @default(autoincrement())
  username   String             @unique
  password   String
  role       String             @default("admin")
  profilePic String?
  mcSkin     String?
  createdAt  DateTime           @default(now())
  accounts   MinecraftAccount[]
  tokens     Token[]
}

model Token {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  type      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}
