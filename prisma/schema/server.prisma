model Server {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  port         Int            @unique
  memory       String         @default("2G")
  version      String         @default("1.21.8")
  path         String         @unique
  avatar       String?
  accentColor  String?
  forwardPort  Int?
  hostname     String?        @unique // ej: "angellap.server01" — usado por MinecraftProxyRouter
  motd         String?
  mcIcon       String?
  softwareType String         @default("purpur")
  onlineMode   Boolean        @default(true) // online-mode: true valida contra Mojang, false para LAN/offline
  syncWithS3   Boolean        @default(true) // Si es true, descarga y sube de S3. Si es false, usa los locales
  createdAt    DateTime       @default(now())
  worlds       World[]
  logs         ServerLog[]
  players         ServerPlayer[]
  pendingCommands ServerPendingCommand[]
  deathMessages   ServerDeathMessage[]
}

model ServerLog {
  id        Int      @id @default(autoincrement())
  serverId  Int
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  level     String   @default("INFO")
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
}

model ServerPlayer {
  id              Int      @id @default(autoincrement())
  serverId        Int
  server          Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name            String
  playtimeSeconds Int      @default(0)
  lastSeen        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([serverId, name])
}

model ServerPendingCommand {
  id        Int      @id @default(autoincrement())
  serverId  Int
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  command   String   @db.Text
  createdAt DateTime @default(now())

  @@index([serverId])
}

model ServerDeathMessage {
  id        Int    @id @default(autoincrement())
  serverId  Int
  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  dimension String
  playerName String?
  message   String @db.Text

  // SQLite considers NULL values as distinct, so multiple nulls for the same dimension are allowed if we just did this, 
  // but Prisma handles @@unique with nulls differently based on the provider. 
  // For SQLite, it allows multiple nulls. We should handle the true uniqueness at the application level if needed,
  // or rely on this constraint.
  @@unique([serverId, dimension, playerName])
}
