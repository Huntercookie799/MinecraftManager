PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

MINECRAFT_DIR=./minecraft/server
PAPER_JAR=./minecraft/server/paper.jar
MINECRAFT_VERSION=1.21.8
PAPER_BUILD=latest

JAVA_BIN=java
JAVA_MIN_MEMORY=1G
JAVA_MAX_MEMORY=2G
JAVA_EXTRA_ARGS=

LOG_BUFFER_SIZE=500
MINECRAFT_STOP_TIMEOUT_MS=30000
MINECRAFT_COMMAND_MAX_LENGTH=500
DATABASE_URL=mysql://root:root@mysql:3306/minecraft_manager

# S3 Storage Config (MinIO default for local)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=minecraft-backups
S3_ACCESS_KEY=root
S3_SECRET_KEY=rootpassword
